#!/bin/bash
unset SSH_AGENT_PID
ssh_info_file=~/.ssh/agent-info-`hostname`
[ -f $ssh_info_file ] && source $ssh_info_file
if [ -z "$SSH_AGENT_PID" ] || ! ps -p $SSH_AGENT_PID >&/dev/null ; then
	ssh-agent | sed 3d > $ssh_info_file
	chmod 700 $ssh_info_file
	source $ssh_info_file
fi
unset ssh_info_file
